# Source novels — NEVER commit.
#
# These are copyrighted texts supplied by the user for local coursework. Git
# retains blobs in history even after a later deletion, so an accidental commit
# is not cleanly reversible. Everything downstream is designed around this:
# data/gold/ stores character offsets and short evidence snippets rather than
# chapter text, precisely so annotations stay shareable without the novels.
data/raw/
*.epub
*.pdf
*.mobi
*.azw3

# Built graph databases — regenerate with `echotales run`.
data/*.db
data/*.db-wal
data/*.db-shm
data/echotales.db*

# Working copies the webview backend edits, so a correction can never mutate
# the originals above. Regenerate with the copy step in HANDOFF §4.18.
data/webview-working/

# Generated review artifacts (contain short text snippets from the sources).
data/review/
data/gold/*.jsonl
data/webview/

# React viewer (packages/pipeline/.../webview.py generates its data)
webview/node_modules/
webview/build/
webview/public/data/

# Induced lexicons are regenerable; keep the genre-neutral seed tracked.
data/lexicons/*.toml
!data/lexicons/_seed.toml

# Chapter-NER cache (mentions/chapter_ner.py::NameCache) -- pure cache, keyed
# by a hash of chapter text, regenerates on the next LLM-backed run.
data/lexicons/*-ner-cache.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
dist/
build/

# Environment
.env
.env.local

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Phase 8: voice bank (~11 GB corpus) and synthesised audio. Both are
# regenerable -- the bank by re-downloading VCTK, the audio by re-running
# `echotales voice` -- and neither belongs in git.
data/voice/
data/audio/
data/reruns/
