# EchoTales .gitignore -- layout of record: data/README.md, docs/README.md.

# ---- Source novels: NEVER commit ------------------------------------------
# Copyrighted texts supplied locally. Git keeps blobs in history even after a
# deletion, so an accidental commit is not cleanly reversible. data/gold/
# stores offsets and short evidence snippets, never chapter text, for exactly
# this reason.
*.epub
*.pdf
*.mobi
*.azw3

# ---- data/: ignored by default, tracked by exception -----------------------
# Every earlier rule here was a wildcard added after some new output folder
# (data/audio_real/, data/panels_v3/, ...) slipped past an exact-name rule.
# A whitelist cannot drift that way: a new folder under data/ is local until
# someone deliberately tracks it below.
data/*
!data/README.md
!data/sources.toml
!data/canonical_dbs.json

# Evaluation results (small JSON/CSV, every paper number cites one). The
# human-review sheets contain windows of copyrighted text: local only.
!data/eval/
data/eval/human_review_*.csv
data/eval/hardcase_review_*.csv
# Same hazard, later names: the pilot sheet and the blind adjudication sheets
# carry a `source_text` column (204-char windows of the novel). They are
# written by scripts/review/ and adjudicated locally; only the guide,
# the metrics JSON and the text-free reconciliation/mapping CSVs are tracked.
data/eval/pilot_review_*.csv
data/eval/adjudication/*_blind.csv
data/eval/compounding/litbank-*.json
# Research arena: aggregate results.json/provenance are tracked; per-unit
# trials are not -- several carry PDNC annotation content (licence unclear,
# see packages/research/.../datasets/pdnc.py) and every one is regenerable
# bit-for-bit from `python -m echotales.research run <experiment>`.
data/eval/research/*/*/trials.jsonl

# Correction logs (the review desk's JSONL; replayable onto a database).
!data/corrections/

# Reference sets. Only the files that can score the pipeline are tracked;
# quarantined sets keep just the README that says why.
!data/gold/
data/gold/*.jsonl
!data/gold/reverend-insanity.jsonl
!data/gold/lord-of-the-mysteries.jsonl
!data/gold/omniscient-readers-viewpoint.jsonl
!data/gold/reverend-insanity-hardcases.jsonl
!data/gold/reverend-insanity-c1-c5.jsonl
data/gold/_unusable/*.jsonl

# Lexicons: induced ones and NER caches regenerate; the seed and the
# hand-written archive are the only authored inputs.
!data/lexicons/
data/lexicons/*.toml
data/lexicons/*-ner-cache.json*
!data/lexicons/_seed.toml

# Per-novel output: binary media stays local; the notes about it are tracked
# (VERSIONS.md is the only record of what each render version was).
!data/novels/
data/novels/**
!data/novels/**/
!data/novels/*/README.md
!data/novels/*/canon/*.json
!data/novels/*/panels/**/VERSIONS.md

# ---- docs/ ------------------------------------------------------------------
# Patent packet and anything embargoed until the IPR decision.
docs/private/

# ---- webview ----------------------------------------------------------------
webview/node_modules/
webview/build/
webview/public/data/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
dist/
build/

# ---- Environment and local tooling ------------------------------------------
.env
.env.local
# Machine-specific (e.g. a local gateway port); config.json.example is the template.
config.json
.claude
graphify-out/
.playwright-mcp/
.DS_Store
.idea/
.vscode/
*.swp
