# Copy to .env and edit. Every value has a working default; the only one you
# are likely to need is ECHOTALES_LLM_MODE.

# stub  - deterministic canned responses. No GPU, no network. CI default.
# local - ollama only. What to use while developing and testing.
# api   - Anthropic only. Highest quality, real cost.
# hybrid- local for bulk work, escalating hard cases to the API.
ECHOTALES_LLM_MODE=stub

# --- local tier (ollama) ---
# `qwen2.5:7b` is already the instruct variant in ollama.
ECHOTALES_LLM_LOCAL_MODEL=qwen2.5:7b
ECHOTALES_LLM_LOCAL_HOST=http://localhost:11434
ECHOTALES_LLM_LOCAL_TIMEOUT=180
# 8192 fits comfortably in 8 GB VRAM alongside a 7B q4 model. Raising this is
# the first thing to try if chapter-level prompts get truncated, and the first
# thing to lower if you hit OOM.
ECHOTALES_LLM_LOCAL_NUM_CTX=8192

# --- api tier (Anthropic) ---
ECHOTALES_LLM_API_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# In hybrid mode, a local answer below this confidence is escalated.
ECHOTALES_ESCALATION_CONFIDENCE_THRESHOLD=0.75
# Hard ceiling on escalated calls per run, so a misconfiguration cannot turn a
# 600-chapter job into an unbounded bill.
ECHOTALES_MAX_ESCALATIONS_PER_RUN=5000

# --- pipeline ---
ECHOTALES_DB_PATH=data/echotales.db
ECHOTALES_WINDOW_SIZE=40
ECHOTALES_CONFORMAL_ALPHA=0.05
