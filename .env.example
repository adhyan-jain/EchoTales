# Copy to .env and edit. Every value has a working default; the only one you
# are likely to need is ECHOTALES_LLM_MODE.

# stub  - deterministic canned responses. No GPU, no network. CI default.
# local - ollama only. What to use while developing and testing.
# api   - Anthropic only. Highest quality, real cost.
# hybrid- local for bulk work, escalating hard cases to the API.
ECHOTALES_LLM_MODE=stub

# --- local tier (ollama) ---
# `qwen2.5:7b` is already the instruct variant in ollama.
ECHOTALES_LLM_LOCAL_MODEL=qwen2.5:7b
ECHOTALES_LLM_LOCAL_HOST=http://localhost:11434
ECHOTALES_LLM_LOCAL_TIMEOUT=180
# 8192 fits comfortably in 8 GB VRAM alongside a 7B q4 model. Raising this is
# the first thing to try if chapter-level prompts get truncated, and the first
# thing to lower if you hit OOM.
ECHOTALES_LLM_LOCAL_NUM_CTX=8192

# --- api tier (Anthropic) ---
ECHOTALES_LLM_API_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# In hybrid mode, a local answer below this confidence is escalated.
ECHOTALES_ESCALATION_CONFIDENCE_THRESHOLD=0.75
# Hard ceiling on escalated calls per run, so a misconfiguration cannot turn a
# 600-chapter job into an unbounded bill.
ECHOTALES_MAX_ESCALATIONS_PER_RUN=5000

# --- pipeline ---
ECHOTALES_DB_PATH=data/echotales.db
ECHOTALES_WINDOW_SIZE=40
ECHOTALES_CONFORMAL_ALPHA=0.05

# --- RunPod (confirmatory study; fill in after the pod is created; never commit .env) ---
# Pod HTTP proxy, with the pod id filled in: https://<POD_ID>-8000.proxy.runpod.net/v1
RUNPOD_BASE_URL=
# The same random string you exported as VLLM_API_KEY inside the pod
RUNPOD_VLLM_KEY=
# Optional: only if you want the agent to start and stop pods for you (otherwise leave empty)
RUNPOD_API_KEY=
RUNPOD_POD_ID=
# Served model names used in the vLLM commands
RUNPOD_SERVED_MODELS=llama70b,qwen72b,olmo32b

# --- compute and providers (pipeline/compute.py) ---
# One switch for how heavy a run may be and where it runs:
#   local-low   (default) laptop-safe: one model at a time, a RAM/GPU check before a render, previews by default,
#               a 4096-token director context. Local models only.
#   local-high  workstation: full chapters, the director's own context, no extra guards (the original behaviour).
#   cloud       RunPod for both the language model and the images; nothing is loaded on this machine.
ECHOTALES_COMPUTE=local-low

# Optional: override what the preset picks, per job. Empty = follow the preset.
#   language: ollama | runpod | openai | gemini | anthropic | gateway | stub
#   images:   local  | runpod | gemini | openrouter | stub
# (Unset, `cloud` means runpod for both and `local-*` means ECHOTALES_MODEL_BACKEND and the local diffusion engine.)
ECHOTALES_LLM_PROVIDER=
ECHOTALES_IMAGE_PROVIDER=
# The local diffusion engine used when the image provider is `local`.
ECHOTALES_LOCAL_IMAGE_ENGINE=noobai

# Scenes per render: a preview and a full chapter. A scene gets one to three images (10 scenes made 33 on LotM ch1).
ECHOTALES_PREVIEW_SCENES=3
ECHOTALES_FULL_SCENES=70

# local-low only. The director's context window; a local render is refused below this much available RAM;
# optionally a smaller director model (measured worse at the director's rules for qwen2.5:7b, so empty by default).
ECHOTALES_LOW_COMPUTE_NUM_CTX=4096
ECHOTALES_LOW_COMPUTE_MIN_FREE_RAM_MB=3000
ECHOTALES_LOW_COMPUTE_DIRECTOR_MODEL=

# Hosted providers. Empty by default; fill only the ones you use; never commit .env.
# RunPod language model: the OpenAI-compatible base URL of a serverless vLLM endpoint
# (https://api.runpod.ai/v2/<endpoint>/openai/v1) or a pod proxy; RunPod images: a serverless endpoint id
# (the worker contract is documented in render/runpod.py).
ECHOTALES_RUNPOD_API_KEY=
ECHOTALES_RUNPOD_LLM_BASE_URL=
ECHOTALES_RUNPOD_LLM_MODEL=
ECHOTALES_RUNPOD_IMAGE_ENDPOINT=
ECHOTALES_OPENAI_API_KEY=
ECHOTALES_OPENAI_MODEL=
ECHOTALES_GEMINI_API_KEY=
ECHOTALES_GEMINI_MODEL=
# The gemini and openrouter IMAGE engines read GEMINI_API_KEY / OPENROUTER_API_KEY themselves, as they always have.
