{"name": "harbour_market", "chapter_start": false, "present": [["Tomas", "boy, about twelve, thin, patched coat"], ["Old Marta", "old woman, apron, strong forearms"]], "referenced": [], "lines": [{"id": "s0", "block": 20, "kind": "narration", "text": "Six hours later the harbour market was at its loudest.", "speaker": ""}, {"id": "s1", "block": 21, "kind": "narration", "text": "Tomas slipped between the stalls with a loaf under his coat.", "speaker": ""}, {"id": "s2", "block": 22, "kind": "speech", "text": "“Thief!”", "speaker": ""}, {"id": "s3", "block": 23, "kind": "speech", "text": "“Stop that boy!”", "speaker": ""}, {"id": "s4", "block": 24, "kind": "speech", "text": "“It's the baker's loaf, I saw him!”", "speaker": ""}, {"id": "s5", "block": 25, "kind": "narration", "text": "The crowd closed around him. Old Marta caught his collar.", "speaker": ""}, {"id": "s6", "block": 26, "kind": "speech", "text": "“Enough,” said Old Marta. “He is hungry, not wicked.”", "speaker": "Old Marta"}, {"id": "s7", "block": 27, "kind": "narration", "text": "Nobody moved. Tomas could hear his own heart.", "speaker": ""}], "output": {"scenes": [{"from_block": 20, "new_scene": true, "place": "the harbour market", "story_time": "six hours later", "layer": "present", "cut_signal": "card", "present": ["Tomas", "Old Marta"], "referenced": []}], "panels": [{"purpose": "time_place_card", "shape": "text_only", "shot": "wide", "layer": "present", "cast": [], "visual": "", "letters": [{"ref": "", "kind": "time_place", "text": "SIX HOURS LATER"}], "blocks": [20], "peak": false, "invented": true, "reason": "time jump stated in block 20"}, {"purpose": "establishing", "shape": "wide", "shot": "extreme_wide", "layer": "present", "cast": [], "visual": "The crowded harbour market, stalls and masts", "letters": [{"ref": "s0", "kind": "narration", "text": ""}], "blocks": [20], "peak": false, "invented": false, "reason": ""}, {"purpose": "beat", "shape": "tall", "shot": "low_angle", "layer": "present", "