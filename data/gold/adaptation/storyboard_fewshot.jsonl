", "shape": "standard", "shot": "medium", "layer": "present", "cast": ["the harbour watchman"], "visual": "The watchman points out to sea from the quay", "letters": [{"ref": "s6", "kind": "shout", "text": ""}], "blocks": [46], "peak": false, "invented": false, "reason": ""}], "cut_lines": []}}
{"name": "pp_ch2_visit", "chapter_start": false, "present": [["Mr. Bennet", "man, middle-aged, dry expression"], ["Mrs. Bennet", "woman, middle-aged, plain day dress"], ["Kitty", "girl, young, thin"], ["Elizabeth", "young woman, dark eyes, bright expression"]], "referenced": ["Mr. Bingley"], "lines": [{"id": "s0", "block": 10, "kind": "speech", "text": "“I have been thinking,” said Mr. Bennet, “that I shall visit Mr. Bingley after all.”", "speaker": "Mr. Bennet"}, {"id": "s1", "block": 11, "kind": "narration", "text": "Mrs. Bennet's mouth fell open. Her daughters turned as one.", "speaker": ""}, {"id": "s2", "block": 12, "kind": "speech", "text": "“How good it was in you, my dear Mr. Bennet! I knew I should persuade you at last.”", "speaker": "Mrs. Bennet"}, {"id": "s3", "block": 13, "kind": "narration", "text": "Kitty began to cough.", "speaker": ""}, {"id": "s4", "block": 14, "kind": "speech", "text": "“Do not be so foolish, Kitty,” said her mother.", "speaker": "Mrs. Bennet"}, {"id": "s5", "block": 15, "kind": "narration", "text": "Elizabeth lowered her eyes to hide a smile.", "speaker": ""}], "output": {"scenes": [{"from_block": 10, "new_scene": false, "place": "", "story_time": "", "layer": "present", "cut_signal": "", "present": ["Mr. Bennet", "Mrs. Bennet", "Kitty", "Elizabeth"], "referenced": ["Mr. Bingley"]}], "panels": [{"purpose": "dialogue", "shape": "standard", "shot": "medium", "layer": "present", "cast": ["Mr. Bennet"], "visual": "Mr. Bennet speaks without looking up from his chair", "letters": [{"ref": "s0", "kind": "speech", "text": ""}], "blocks": [10], "peak": false, "invented": false, "reason": ""}, {"purpose": "reaction", "shape": "wide", "shot": "medium", "layer": "present", "cast": ["Mrs. Bennet", "Kitty", "Elizabeth"], "visual": "Mrs. Bennet's mouth open, the girls turning toward the father", "letters": [{"ref": "s1", "kind": "narration", "text": ""}], "blocks": [11], "peak": true, "invented": false, "reason": ""}, {"purpose": "extreme_close"