{"name": "storm_memory_cut", "chapter_start": false, "present": [["Captain Ilse", "woman, fifty, grey braid, oilskin coat"]], "referenced": ["her brother Joren"], "lines": [{"id": "s0", "block": 40, "kind": "narration", "text": "The storm had held the ship for three nights.", "speaker": ""}, {"id": "s1", "block": 41, "kind": "narration", "text": "Captain Ilse sat by the lamp and did not sleep.", "speaker": ""}, {"id": "s2", "block": 42, "kind": "thought", "text": "“Joren would have turned back at the strait,” she thought.", "speaker": ""}, {"id": "s3", "block": 43, "kind": "narration", "text": "Years ago her brother had stood at this same wheel, laughing into the spray.", "speaker": ""}, {"id": "s4", "block": 44, "kind": "narration", "text": "The lamp guttered and went out.", "speaker": ""}, {"id": "s5", "block": 45, "kind": "narration", "text": "Dawn came grey over the harbour of Karst, and a gull cried on the quay.", "speaker": ""}, {"id": "s6", "block": 46, "kind": "speech", "text": "“Ship in sight!” the harbour watchman called.", "speaker": ""}], "output": {"scenes": [{"from_block": 40, "new_scene": true, "place": "aboard the ship in the storm", "story_time": "three nights into the storm", "layer": "present", "cut_signal": "", "present": ["Captain Ilse"], "referenced": ["her brother Joren"]}, {"from_block": 45, "new_scene": true, "place": "the harbour of Karst", "story_time": "dawn after the storm", "layer": "present", "cut_signal": "match", "present": ["the harbour watchman"], "referenced": []}], "panels": [{"purpose": "establishing", "shape": "wide", "shot": "extreme_wide", "layer": "present", "cast": [], "visual": "A ship tossed by dark waves under black cloud, rain in lines", "letters": [{"ref": "s0", "kind": "narration", "text": ""}], "blocks": [40], "peak": false, "invented": false, "reason": ""}, {"purpose": "insert", "shape": "inset", "shot": "insert", "layer": "present", "cast": [], "visual": "Rain hammering the cabin glass", "letters": [{"ref": "", "ki