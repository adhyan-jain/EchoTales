{"name": "pp_open", "chapter_start": true, "present": [["Mrs. Bennet", "woman, middle-aged, plain day dress"], ["Mr. Bennet", "man, middle-aged, dry expression"]], "referenced": ["Mrs. Long", "Mr. Morris"], "lines": [{"id": "s0", "block": 0, "kind": "narration", "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife.", "speaker": ""}, {"id": "s1", "block": 1, "kind": "narration", "text": "However little known the feelings or views of such a man may be on his first entering a neighbourhood, this truth is so well fixed in the minds of the surrounding families, that he is considered the rightful property of some one or other of their daughters.", "speaker": ""}, {"id": "s2", "block": 2, "kind": "speech", "text": "“My dear Mr. Bennet, have you heard that Netherfield Park is let at last?”", "speaker": "Mrs. Bennet"}, {"id": "s3", "block": 3, "kind": "narration", "text": "Mr. Bennet replied that he had not.", "speaker": ""}, {"id": "s4", "block": 4, "kind": "speech", "text": "“But it is,” returned she; “for Mrs. Long has just been here, and she told me all about it.”", "speaker": "Mrs. Bennet"}, {"id": "s5", "block": 5, "kind": "narration", "text": "Mr. Bennet made no answer.", "speaker": ""}, {"id": "s6", "block": 6, "kind": "speech", "text": "“Do you not want to know who has taken it?” cried his wife impatiently.", "speaker": "Mrs. Bennet"}, {"id": "s7", "block": 7, "kind": "speech", "text": "“You want to tell me, and I have no objection to hearing it.”", "speaker": "Mr. Bennet"}, {"id": "s8", "block": 8, "kind": "speech", "text": "“Why, my dear, you must know, Mrs. Long says that Netherfield is taken by a young man of large fortune from the north of England; that he came down on Monday in a chaise and four to see the place.”", "speaker": "Mrs. Bennet"}], "output": {"scenes": [{"from_block": 0, "new_scene": true, "place": "the Bennets' sitting room", "story_time": "a morning in autumn", "layer": "present", "cut_signal": "", "present": ["Mrs. Bennet", "Mr. Bennet"], "referenced": ["Mrs. Long", "Mr. Morris"]}], "panels": [{"purpose": "cold_open", "shape": "wide", "shot": "extreme_wide", "layer": "present", "cast": [], "visual": "A chaise and four on a country lane heading toward a large house on a hill, dusk", "letters": [{"ref": "s0", "kind": "narration", "text": ""}], "blocks": [0], "peak": false, "invented": true, "reason": "hook image from the chaise in block 8, no new fact"}, {"purpose": "establishing", "shape": "wide", "shot": "wide", "layer": "present", "cast": [], "visual": "The front of a modest country house, a lit window", "letters": [{"ref": "s1", "kind": "narration", "text": ""}], "blocks": [1], "peak": false, "invented": false, "reason": ""}, {"purpose": "dialogue", "shape": "standard", "shot": "medium", "layer": "present", "cast": ["Mrs. Bennet", "Mr. Bennet"], "visual": "Mrs. Bennet leans toward Mr. Bennet, who sits with a book", "letters": [{"ref": "s2", "kind": "speech", "text": ""}], "blocks": [2], "peak": false, "invented": false, "reason": ""}, {"purpose": "reaction", "shape": "inset", "shot": "close", "layer": "present", "cast": ["Mr. Bennet"], "visual": "Mr. Bennet glances up over the book, unmoved", "letters": [{"ref": "s3", "kind": "narration", "text": ""}], "blocks": [3], "peak": false, "invented": false, "reason": ""}, {"purpose": "dialogue", "shape": "standard", "shot": "medium_close", "layer": "present", "cast": ["Mrs. Bennet"], "visual": "Mrs. Bennet insists, hand raised", "letters": [{"ref": "s4", "kind": "speech", "text": ""}], "blocks": [4], "peak": false, "invented": false, "reason": ""}, {"purpose": "insert", "shape": "inset", "shot": "insert", "layer": "present", "cast": [], "visual": "Mr. Bennet's finger holding his place in the book", "letters": [{"ref": "s5", "kind": "narration", "text": ""}], "blocks": [5], "peak": false, "invented": false, "reason": ""}, {"purpose": "dialogue", "shape": "diagonal", "shot": "medium", "layer